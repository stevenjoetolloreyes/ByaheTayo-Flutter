// EstudyanteGO Firestore security rules — shared community posts
// and server-side student profiles.
//
// Collection: community_posts
// Document fields: routeName, vehicles, hours, fare, hubName, from,
//   to, photoBase64 (optional), faresByVehicle, operatorName,
//   status ('pending' | 'approved' | 'rejected'), authorUid,
//   createdAt (server timestamp), rejectionReason (optional,
//   admin-set on a rejection, max 300 characters, shown only to the
//   post's author).
//
// Visibility (mirrored client-side in
// lib/features/community_post_repository.dart — these rules are the
// real enforcement):
//   approved posts  → any signed-in user may read
//   pending posts   → only the author (authorUid == uid) or an admin
//   rejected posts  → only the author or an admin may read; they
//     never appear in any other user's view
// Creates must stamp the caller's own UID and start pending. Status
// changes and deletes are admin-only (allowlisted emails below). A
// rejection reason may only be set alongside a rejection.
// LGU complaints stay local-only and never touch Firestore.
//
// Collection: student_profiles
// Document ID: the authenticated Firebase UID (one document per
//   user — see lib/features/profile_repository.dart).
// Document fields: school, program, yearLevel (nullable strings),
//   profilePhotoUrl (nullable string — the Firebase Storage
//   download URL of the user's own uploaded photo; the photo bytes
//   themselves live in Storage, never here), updatedAt (server
//   timestamp).
// Owner-only: a signed-in user may read or write ONLY the document
// whose ID equals their own UID. No admin override — a student's
// school/program/year/photo is theirs alone. The rule is
// document-level, so the new profilePhotoUrl field needs no
// separate rule.
//
// Friend codes + requests (see
// lib/features/friend_cloud_repository.dart):
//   friend_codes/{code}     — document ID IS the code; get-only
//     lookup, so codes can never be listed or enumerated.
//   user_friend_codes/{uid} — owner-only mapping from UID to code.
//   friend_requests/{id}    — participant-only; created pending by
//     the sender, answered (accept/decline) by the recipient only,
//     never deleted.
//
// Queue #2 (Credits, Scanner gating, Ads — see
// lib/features/credits_repository.dart):
//   credits_wallets/{uid}     — credits cache, owner-only
//   credits_transactions/{id} — append-only credits ledger
//   credit_redemptions/{id}   — one redemption per user per day
//   scan_counters/{id}        — per-user per-day scan counters
//   ad_rewards/{id}           — SERVER-ONLY writes (SSV), app reads
//   admin_settings/global     — admin-only writes, app reads
//   points_transactions       — also accepts negative 'redemption'
//     debits (same ledger, no duplicate wallet).
// Rules enforce the SHAPE of each write, not the TRUTH of the
// event: see the credits file header for the honest limits.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email in [
        'stevenjoereyes0625@gmail.com',
        'stevenjoereyes23@gmail.com',
      ];
    }

    match /community_posts/{postId} {
      allow read: if isSignedIn()
        && (resource.data.status == 'approved'
          || resource.data.authorUid == request.auth.uid
          || isAdmin());

      // Creates never carry a rejection reason — a reason is only
      // ever set by an admin on a rejection (see update below).
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('rejectionReason' in request.resource.data);

      // Admins may change ONLY the status field (approve/reject)
      // and, on a rejection, the optional rejectionReason (max 300
      // characters). A reason may only be touched alongside a
      // rejection: touching it while approving is denied, so an
      // approved post can never gain a reason. Rejecting without a
      // reason deletes the field (clearing any stale reason from an
      // earlier rejection cycle); approving leaves the field
      // untouched, and the app only ever displays a reason while
      // the post is rejected. Status is bound to the two admin
      // decisions — it can never be set back to pending or to an
      // arbitrary value.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'rejectionReason'])
        && request.resource.data.status in ['approved', 'rejected']
        && (!('rejectionReason'
              in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.status == 'rejected')
        && (!('rejectionReason' in request.resource.data)
            || (request.resource.data.rejectionReason is string
              && request.resource.data.rejectionReason.size() <= 300));

      allow delete: if isAdmin();
    }

    // Post interactions — Like / Dislike / Comment on approved
    // shared posts (see lib/features/community_interactions.dart).
    //
    // community_reactions/{postId_uid}: one document per user per
    // post — the document ID binds the reaction to its post and its
    // author, so a duplicate reaction is impossible by construction.
    // Toggle-off deletes the document; switching rewrites it.
    // community_post_stats/{postId}: display counters maintained by
    // the SAME app transaction that writes the reaction or comment.
    // Rules bound every write to a single valid step (one counter
    // ±1, or a like↔dislike switch); the reaction and comment
    // documents themselves are the auditable source, and a client
    // that bypasses the app could still step a counter without a
    // matching reaction — the same client-plus-rules shape limit as
    // the points ledger, not a proof of counts.
    // community_comments/{commentId}: public comments on approved
    // posts only. Authors delete only their own comments; edits are
    // denied outright.
    //
    // The read rule for reactions includes the null arm: the reaction
    // transaction first reads a document that may not exist yet, and
    // a resource.data-only read rule would deny that read (resource
    // is null) and break every first reaction — the same bug fixed
    // Nov 2 in points_transactions.
    function postIsApproved(postId) {
      return get(/databases/$(database)/documents/community_posts/$(postId))
        .data.status == 'approved';
    }

    function stepDelta(oldVal, newVal) {
      return newVal - oldVal;
    }

    match /community_reactions/{reactionId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && reactionId == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.value in ['like', 'dislike']
        && postIsApproved(request.resource.data.postId);
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['value', 'updatedAt'])
        && request.resource.data.value in ['like', 'dislike']
        && postIsApproved(resource.data.postId);
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /community_post_stats/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && postIsApproved(postId)
        && request.resource.data.keys()
          .hasOnly(['likeCount', 'dislikeCount', 'commentCount', 'updatedAt'])
        && request.resource.data.likeCount is int
        && request.resource.data.dislikeCount is int
        && request.resource.data.commentCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.dislikeCount >= 0
        && request.resource.data.commentCount >= 0
        && request.resource.data.likeCount
          + request.resource.data.dislikeCount
          + request.resource.data.commentCount == 1;
      allow update: if isSignedIn()
        && postIsApproved(postId)
        && request.resource.data.keys()
          .hasOnly(['likeCount', 'dislikeCount', 'commentCount', 'updatedAt'])
        && request.resource.data.likeCount is int
        && request.resource.data.dislikeCount is int
        && request.resource.data.commentCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.dislikeCount >= 0
        && request.resource.data.commentCount >= 0
        && (
          (request.resource.data.commentCount == resource.data.commentCount
            && ((stepDelta(resource.data.likeCount, request.resource.data.likeCount) == 1
              && stepDelta(resource.data.dislikeCount, request.resource.data.dislikeCount) == 0)
              || (stepDelta(resource.data.likeCount, request.resource.data.likeCount) == 0
                && stepDelta(resource.data.dislikeCount, request.resource.data.dislikeCount) == 1)
              || (stepDelta(resource.data.likeCount, request.resource.data.likeCount) == -1
                && stepDelta(resource.data.dislikeCount, request.resource.data.dislikeCount) == 0)
              || (stepDelta(resource.data.likeCount, request.resource.data.likeCount) == 0
                && stepDelta(resource.data.dislikeCount, request.resource.data.dislikeCount) == -1)
              || (stepDelta(resource.data.likeCount, request.resource.data.likeCount) == -1
                && stepDelta(resource.data.dislikeCount, request.resource.data.dislikeCount) == 1)
              || (stepDelta(resource.data.likeCount, request.resource.data.likeCount) == 1
                && stepDelta(resource.data.dislikeCount, request.resource.data.dislikeCount) == -1)))
          || (request.resource.data.likeCount == resource.data.likeCount
            && request.resource.data.dislikeCount == resource.data.dislikeCount
            && (stepDelta(resource.data.commentCount, request.resource.data.commentCount) == 1
              || stepDelta(resource.data.commentCount, request.resource.data.commentCount) == -1))
        );
      allow delete: if false;
    }

    match /community_comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.postId.size() > 0
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.text.matches('.*\\S.*')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 100
        && (!('photoUrl' in request.resource.data)
          || request.resource.data.photoUrl is string)
        && request.resource.data.createdAt == request.time
        && postIsApproved(request.resource.data.postId);
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /student_profiles/{userId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId;
    }

    // Points wallet cache (one document per user — see
    // lib/features/points_wallet_repository.dart). The balance is
    // repaired from the ledger on load, so the doc itself only
    // needs owner-only access; the ledger rules below are the
    // real amount enforcement.
    match /points_wallets/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Points ledger — APPEND-ONLY. A signed-in user may read only
    // their own entries and may create only their own entries: the
    // document ID must equal the entry's referenceId. Sign-in
    // credits use the `signin_<uid>_<date>` idempotency reference,
    // points must be a reward-table value (10, or 50 on Day 7), and
    // the cycle day must be 1..7. Queue #2 redeem-all writes a
    // NEGATIVE 'redemption' debit into this same ledger (no
    // duplicate wallet): a redemption has no cycle day, and its
    // points must be negative. Updates and deletes are denied, so
    // history can never be rewritten or erased. HONEST LIMIT:
    // rules cannot prove a redemption debit equals the user's real
    // balance — only a server could.
    match /points_transactions/{txnId} {
      // The claim transaction first reads the claim doc to check it
      // does not exist yet. A rule that only checks resource.data
      // denies reads of documents that do not exist (resource is
      // null, so the deref errors and an error is a deny) — which
      // would reject every first-time claim. The null arm only
      // permits reading an absent doc (which returns nothing);
      // existing docs still require ownership.
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.referenceId == txnId
        && request.resource.data.status == 'completed'
        && request.resource.data.points is int
        && (
          (request.resource.data.type == 'signin'
            && request.resource.data.points in [10, 50]
            && request.resource.data.dayIndex is int
            && request.resource.data.dayIndex >= 1
            && request.resource.data.dayIndex <= 7)
          || (request.resource.data.type == 'redemption'
            && request.resource.data.source == 'redemption'
            && request.resource.data.points < 0)
        );
      allow update, delete: if false;
    }

    // Friend codes — exact-code lookup docs. The document ID IS the
    // code: lookup is a get-only read (listing is denied), so codes
    // cannot be enumerated. Creates stamp the caller's UID and must
    // match the document ID; only the owner may change or delete.
    match /friend_codes/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.code == code;
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // Per-user friend-code mapping (owner-only): lets a user find
    // their own cloud code without listing anyone else's.
    match /user_friend_codes/{userId} {
      allow read, write: if isSignedIn()
        && request.auth.uid == userId;
    }

    // Friend requests — participant-only. A request may be created
    // only by its sender, starting pending, to someone else. Only
    // the recipient may change its status (accept/decline), and only
    // the status field may change. Reads are limited to requests
    // the user sent or received; deletes are denied.
    match /friend_requests/{requestId} {
      allow read: if isSignedIn()
        && (resource.data.from == request.auth.uid
          || resource.data.to == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn()
        && resource.data.to == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt']);
      allow delete: if false;

    // Credits wallet cache (Queue #2 — see
    // lib/features/credits_repository.dart). Same pattern as the
    // points wallet: owner-only access; the balance is repaired
    // from the credits ledger on load, so the doc itself only
    // needs ownership, not value checks.
    match /credits_wallets/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Credits ledger — APPEND-ONLY. Owner-only reads (with the null
    // arm: transactions read docs that may not exist yet) and
    // owner-only creates: the document ID must equal the entry's
    // referenceId, units must be a non-zero integer, redemption
    // credits are positive, scan charges are negative, and the
    // source must match the type. There is deliberately NO
    // 'ad_reward' client type: verified ad credits are written by
    // a future trusted backend only (see ad_rewards below).
    // Updates and deletes are denied.
    match /credits_transactions/{txnId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.referenceId == txnId
        && request.resource.data.status == 'completed'
        && request.resource.data.units is int
        && request.resource.data.units != 0
        && (
          (request.resource.data.type == 'redemption'
            && request.resource.data.source == 'redemption'
            && request.resource.data.units > 0)
          || (request.resource.data.type == 'scan_charge'
            && request.resource.data.source == 'scan'
            && request.resource.data.units < 0)
        );
      allow update, delete: if false;
    }

    // Redemption records — one per user per day (Queue #2
    // redeem-all). The document ID is the deterministic
    // `redeem_<uid>_<date>` reference, so a second redemption the
    // same day is impossible by construction. Units credited must
    // equal points redeemed (1 point = 1 minor unit). HONEST
    // LIMIT: rules cannot prove the redeemed amount equals the
    // user's real points balance.
    match /credit_redemptions/{redemptionId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.pointsRedeemed is int
        && request.resource.data.pointsRedeemed > 0
        && request.resource.data.unitsCredited
          == request.resource.data.pointsRedeemed
        && request.resource.data.status == 'completed';
      allow update, delete: if false;
    }

    // AI Scanner counters — one per user per day. Free scans are
    // capped at 3/day; every counter step is exactly +1 on one
    // field at a time (same step-bound pattern as post stats).
    // HONEST LIMIT: rules bound each counter write, but cannot
    // prove a scan actually happened — that proof needs a server.
    match /scan_counters/{counterId} {
      allow read: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.freeUsed is int
        && request.resource.data.freeUsed >= 0
        && request.resource.data.freeUsed <= 3
        && request.resource.data.paidUsed is int
        && request.resource.data.paidUsed >= 0;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['freeUsed', 'paidUsed', 'updatedAt'])
        && (request.resource.data.freeUsed == resource.data.freeUsed
          || request.resource.data.freeUsed == resource.data.freeUsed + 1)
        && (request.resource.data.paidUsed == resource.data.paidUsed
          || request.resource.data.paidUsed == resource.data.paidUsed + 1)
        && (request.resource.data.freeUsed != resource.data.freeUsed
          || request.resource.data.paidUsed != resource.data.paidUsed);
      allow delete: if false;
    }

    // Ad-reward entries — SERVER-ONLY. Client creates are denied
    // outright: a verified ad credit may only be written by a
    // trusted backend (Admin SDK bypasses rules) after AdMob SSV
    // verification. The app reads this collection for history only.
    // Until the SSV server exists this collection stays empty —
    // never faked, never client-granted.
    match /ad_rewards/{rewardId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Admin settings — one 'global' document. Reads are open to
    // signed-in users (the app needs the daily limit + toggles);
    // writes are admin-only via the existing allowlist. The daily
    // ad limit is admin-configurable; the rewarded amount is fixed
    // at 0.50 credits (50 minor units). HONEST LIMIT: the app
    // self-enforces the limit in normal use — enforcement against
    // bypassing clients needs a server.
    match /admin_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.data.dailyAdLimit is int
        && request.resource.data.dailyAdLimit >= 0
        && request.resource.data.rewardedAdsEnabled is bool
        && request.resource.data.popupAdsEnabled is bool
        && request.resource.data.rewardedAmountUnits == 50;
      allow delete: if false;
    }
    }
  }
}
