<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:label="EstudyanteGO"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Google Maps API key from android/local.properties (MAPS_API_KEY).
             Never hard-code a key here. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- AdMob App ID: Google's OFFICIAL TEST App ID. Replace it
             with the real App ID in the same web-edit session that
             fills lib/features/ad_config.dart. Never paste real
             AdMob IDs in chat. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- Bible Verse home screen widget (Android only). The
             provider reads the pushed verse list from the
             home_widget SharedPreferences and picks today's verse
             by day-of-year; tapping the widget opens the app. -->
        <receiver
            android:name=".BibleVerseWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Bible Verse">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bible_verse_widget_info" />
        </receiver>
        <!-- Schedule home screen widgets (Android only), small 4x2
             "Next Class" and big 4x3 "This Week". Approved preview
             v2 (Nov 11, 2026). Each provider reads the pushed
             schedule JSON from the home_widget SharedPreferences
             and derives today / next class on every update; tapping
             either widget opens the app's Classes screen. -->
        <receiver
            android:name=".ScheduleWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Schedule">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_info" />
        </receiver>
        <receiver
            android:name=".ScheduleWeekWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Schedule — This Week">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/schedule_widget_week_info" />
        </receiver>
        <!-- EstudyanteGO Allowance widget (Nov 11, 2026). -->
        <receiver
            android:name=".AllowanceWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Allowance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/allowance_widget_info" />
        </receiver>
        <!-- EstudyanteGO Money widget (Nov 11, 2026). -->
        <receiver
            android:name=".AllowanceMoneyWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Money">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/allowance_widget_money_info" />
        </receiver>
        <!-- EstudyanteGO Fares widget (Nov 11, 2026). -->
        <receiver
            android:name=".FaresWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Fares">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fares_widget_info" />
        </receiver>
        <!-- EstudyanteGO Popular Routes widget (Nov 11, 2026). -->
        <receiver
            android:name=".FaresPopularWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Popular Routes">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fares_widget_popular_info" />
        </receiver>
        <!-- EstudyanteGO Daily Quote widget (Nov 11, 2026). -->
        <receiver
            android:name=".DailyQuotesWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Daily Quote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_quotes_widget_info" />
        </receiver>
        <!-- EstudyanteGO Daily Quote widget (Nov 11, 2026). -->
        <receiver
            android:name=".DailyQuotesSquareWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Daily Quote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_quotes_widget_square_info" />
        </receiver>
        <!-- EstudyanteGO Daily Quote widget (Nov 11, 2026). -->
        <receiver
            android:name=".DailyQuotesLargeWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Daily Quote">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_quotes_widget_large_info" />
        </receiver>
        <!-- EstudyanteGO Tasks widget (Nov 11, 2026). -->
        <receiver
            android:name=".TasksWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_info" />
        </receiver>
        <!-- EstudyanteGO Tasks widget (Nov 11, 2026). -->
        <receiver
            android:name=".TasksSquareWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_square_info" />
        </receiver>
        <!-- EstudyanteGO Tasks widget (Nov 11, 2026). -->
        <receiver
            android:name=".TasksLargeWidgetProvider"
            android:exported="true"
            android:label="EstudyanteGO Tasks">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tasks_widget_large_info" />
        </receiver>
        <!-- DIAGNOSTIC ONLY (Nov 4, 2026): disable androidx.startup initializers to test whether one of them crashes launch before MainActivity. Revert after the test result. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="remove" />
    </application>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Requested once, after sign-in/profile setup, with an explanation
         (see notification_prompt.dart). Never requested at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms (Android 12+) for on-time local reminders
         (class reminders, daily login). The plugin falls back to
         inexact alarms when the user has not allowed exact alarms
         in system settings; see local_notifications.dart. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Walking Goal step counting (Android 10+ runtime permission
         for the TYPE_STEP_COUNTER sensor). Requested only when the
         user taps "Allow activity tracking" on the Walking Goal
         card, never at launch. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Walking Goal Health Connect fallback: read today's steps
         from Health Connect when the phone has no step-counter
         sensor. Granted in the Health Connect app (never at
         launch, never via the runtime permission dialog). -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- AI quiz generation: photograph notes (Camera) and pick
         pictures (gallery) for Gemini multimodal input. The system
         photo picker is used on Android 13+; READ_MEDIA_IMAGES
         covers older gallery access and READ_EXTERNAL_STORAGE is
         capped at Android 12 and below. Requested only when the
         user taps Camera / Picture on the generate screen, never
         at launch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
