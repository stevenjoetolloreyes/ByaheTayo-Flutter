<?xml version="1.0" encoding="utf-8"?>
<!-- Schedule widget — Next Class (4x2) PREVIEW layout (launcher picker).
     Static sample content from the approved preview v2 (Nov 11, 2026):
     Monday, 3 classes, 1 done; next CT102 10:00 AM-12:00 PM CC105.
     The live layout is schedule_widget.xml; the provider fills it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/schedule_widget_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/launch_image"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="SCHEDULE"
            android:textColor="#21301A"
            android:textSize="13sp"
            android:textStyle="bold" 
            android:fontFamily="@font/press_start_2p"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Classes today"
        android:textColor="#21301A"
        android:textSize="15sp"
        android:textStyle="bold" 
        android:fontFamily="@font/baloo_2"/>

    <TextView
        android:id="@+id/widget_today_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#5A6B52"
        android:textSize="12sp" 
        android:fontFamily="@font/baloo_2" android:text="Mon · 3 classes"/>
    <LinearLayout
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/widget_progress_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/baloo_2"
            android:text="1 of 3 done"
            android:textColor="#5A6B52"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/widget_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="2dp"
            android:max="100"
            android:progress="33"
            android:progressTint="#58CC02"
            android:progressBackgroundTint="#D9D9D9" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/widget_next_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/schedule_widget_next_card"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEXT CLASS · CT102"
            android:textColor="#2F7A12"
            android:textSize="11sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Computer Programming 1"
            android:textColor="#21301A"
            android:textSize="14sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_next_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#21301A"
            android:textSize="12sp" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="10:00 AM–12:00 PM · CC105"
            android:textColor="#21301A"
            android:textSize="12sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="COMING UP"
            android:textColor="#5A6B52"
            android:textSize="9sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_next_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today at 10:00 AM"
            android:textColor="#21301A"
            android:textSize="12sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No subjects yet."
            android:textColor="#21301A"
            android:textSize="14sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a subject to build your timetable."
            android:textColor="#5A6B52"
            android:textSize="12sp" 
            android:fontFamily="@font/baloo_2"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_google_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/schedule_widget_g_badge"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="10sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="GOOGLE CALENDAR"
                android:textColor="#21301A"
                android:textSize="11sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_google_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/schedule_widget_g_badge"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="10sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_google_title_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="NSTP 1"
                android:textColor="#21301A"
                android:textSize="12sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_google_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/schedule_widget_g_badge"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="10sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_google_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Life and Works of Rizal"
                android:textColor="#21301A"
                android:textSize="12sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_google_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/schedule_widget_g_badge"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="10sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_google_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Discrete Mathematics"
                android:textColor="#21301A"
                android:textSize="12sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_google_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/schedule_widget_g_badge"
                android:gravity="center"
                android:text="G"
                android:textColor="#4285F4"
                android:textSize="10sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_google_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Vigan"
                android:textColor="#21301A"
                android:textSize="12sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_google_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#5A6B52"
            android:textSize="11sp"
            android:visibility="gone" 
            android:fontFamily="@font/baloo_2"/>
    </LinearLayout>
</LinearLayout>
