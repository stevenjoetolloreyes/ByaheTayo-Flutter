<?xml version="1.0" encoding="utf-8"?>
<!-- Fares widget — Popular Routes (4x3). Approved preview v1 (Nov 11, 2026). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/launch_image"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="POPULAR ROUTES"
            android:textColor="#21301A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_size_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="4×3"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/widget_route_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_route_0_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cabugao → Vigan Bus Terminal"
                    android:textColor="#21301A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_route_0_fare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱60"
                    android:textColor="#2F7A12"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_route_0_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₱48 student · ≈ 31.6 km"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_route_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_route_1_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cabugao → San Juan, Ilocos Sur"
                    android:textColor="#21301A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_route_1_fare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱20"
                    android:textColor="#2F7A12"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_route_1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₱16 student · ≈ 6.7 km"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_route_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_route_2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sinait → Cabugao"
                    android:textColor="#21301A"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_route_2_fare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱20"
                    android:textColor="#2F7A12"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_route_2_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₱16 student · ≈ 12.1 km"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_min_fare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Minimum fare ₱20"
            android:textColor="#9C6B30"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open EstudyanteGO to load fares."
            android:textColor="#21301A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fares load from the Fares tab when the app opens."
            android:textColor="#5A6B52"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
