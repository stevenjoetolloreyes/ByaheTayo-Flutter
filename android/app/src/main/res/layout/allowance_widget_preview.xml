        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Available balance"
            android:textColor="#5A6B52"
            android:textSize="13sp"
            android:fontFamily="@font/baloo_2" />

        <TextView
            android:id="@+id/widget_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:textColor="#2F7A12"
            android:textSize="30sp"
            android:fontFamily="@font/baloo_2"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_month_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_month_in"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="In: ₱0"
                android:textColor="#21301A"
                android:textSize="14sp"
                android:fontFamily="@font/baloo_2" />

            <TextView
                android:id="@+id/widget_month_out"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Out: ₱0"
                android:textColor="#21301A"
                android:textSize="14sp"
                android:fontFamily="@font/baloo_2" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No transactions yet."
            android:textColor="#5A6B52"
            android:textSize="12sp"
            android:fontFamily="@font/baloo_2"
            android:visibility="gone" />
