<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks widget — Tasks (4×3). PREVIEW layout (launcher picker). Static sample content from the approved preview v1 (Nov 11, 2026). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/launch_image"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="TASKS"
            android:textColor="#21301A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_size_chip"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="4×3"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_pending_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 pending"
        android:textColor="#21301A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending tasks."
            android:textColor="#21301A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a task to get started."
            android:textColor="#5A6B52"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3 exercises"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_0_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing · Assignment · due Nov 13, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3 exercises"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing · Assignment · due Nov 13, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3 exercises"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_2_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing · Assignment · due Nov 13, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_3_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3 exercises"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_3_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing · Assignment · due Nov 13, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_4_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3 exercises"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task_4_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing · Assignment · due Nov 13, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="+1 more"
        android:textColor="#5A6B52"
        android:textSize="11sp"
        android:visibility="gone" />
    <LinearLayout
        android:id="@+id/widget_done_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_done_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 of 0 done"
            android:textColor="#2F7A12"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/widget_done_0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Quiz 2"
                android:textColor="#5A6B52"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_done_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_done_1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓ Chapter 1 exercises"
                android:textColor="#5A6B52"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
