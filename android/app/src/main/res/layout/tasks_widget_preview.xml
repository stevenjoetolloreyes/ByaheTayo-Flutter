<?xml version="1.0" encoding="utf-8"?>
<!-- Tasks widget — Tasks (4×2). PREVIEW layout (launcher picker). Static sample content from the approved preview v1 (Nov 11, 2026). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/launch_image"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="MY TASKS"
            android:textColor="#21301A"
            android:textSize="13sp"
            android:textStyle="bold" 
            android:fontFamily="@font/press_start_2p"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        
    </LinearLayout>
    <TextView
        android:id="@+id/widget_pending_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="2 pending"
        android:textColor="#21301A"
        android:textSize="15sp"
        android:textStyle="bold" 
        android:fontFamily="@font/baloo_2"/>

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No pending tasks."
            android:textColor="#21301A"
            android:textSize="14sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add a task to get started."
            android:textColor="#5A6B52"
            android:textSize="12sp" 
            android:fontFamily="@font/baloo_2"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_0_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chapter 3 exercises"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_task_0_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Introduction to Computing · Assignment · due Nov 13, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_task_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="visible">

        <TextView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/widget_bar_fill"
            android:text="" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_task_1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quiz 2 — Binary numbers"
                android:textColor="#21301A"
                android:textSize="13sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_task_1_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Computer Programming 1 · Quiz · due Nov 14, 2026"
                android:textColor="#5A6B52"
                android:textSize="11sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>
    </LinearLayout>
        <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="33"
        android:progressTint="#58CC02"
        android:progressBackgroundTint="#D9D9D9"
        android:visibility="visible" />
<TextView
        android:id="@+id/widget_done_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="1 of 3 done"
        android:textColor="#5A6B52"
        android:textSize="11sp"
        android:visibility="visible" 
        android:fontFamily="@font/baloo_2"/>
</LinearLayout>
