<?xml version="1.0" encoding="utf-8"?>
<!-- Fares widget — Fares (4x2). Approved preview v1 (Nov 11, 2026). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/launch_image"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="FARES"
            android:textColor="#21301A"
            android:textSize="13sp"
            android:textStyle="bold" 
            android:fontFamily="@font/press_start_2p"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:text="" />

        
    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_route"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cabugao → Vigan Bus Terminal"
            android:textColor="#21301A"
            android:textSize="15sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_operator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus"
            android:textColor="#5A6B52"
            android:textSize="12sp" 
            android:fontFamily="@font/baloo_2"/>

        <LinearLayout
            android:id="@+id/widget_fare_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_fare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱60"
                android:textColor="#2F7A12"
                android:textSize="20sp"
                android:textStyle="bold" 
                android:fontFamily="@font/baloo_2"/>

            <TextView
                android:id="@+id/widget_student_fare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="₱48 student"
                android:textColor="#5A6B52"
                android:textSize="12sp" 
                android:fontFamily="@font/baloo_2"/>
        </LinearLayout>

        <TextView
            android:id="@+id/widget_fare_not_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fare not set"
            android:textColor="#5A6B52"
            android:textSize="14sp"
            android:visibility="gone" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_distance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="≈ 31.6 km · 1 hr 10 min"
            android:textColor="#5A6B52"
            android:textSize="12sp" 
            android:fontFamily="@font/baloo_2"/>
        <LinearLayout
            android:id="@+id/widget_fare_chart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/baloo_2"
                android:text="Regular vs student"
                android:textColor="#2F7A12"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/widget_fare_bar_0"
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal">

                            <TextView
                                android:id="@+id/widget_fare_bar_0_level_0"
                                android:layout_width="12dp"
                                android:layout_height="4dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="visible" />
                            <TextView
                                android:id="@+id/widget_fare_bar_0_level_1"
                                android:layout_width="12dp"
                                android:layout_height="8dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/widget_fare_bar_0_level_2"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/widget_fare_bar_0_level_3"
                                android:layout_width="12dp"
                                android:layout_height="16dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/widget_fare_bar_0_level_4"
                                android:layout_width="12dp"
                                android:layout_height="20dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/widget_fare_bar_0_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Regular"
                        android:textColor="#5A6B52"
                        android:textSize="9sp"
                        android:fontFamily="@font/baloo_2" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <FrameLayout
                        android:id="@+id/widget_fare_bar_1"
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal">

                            <TextView
                                android:id="@+id/widget_fare_bar_1_level_0"
                                android:layout_width="12dp"
                                android:layout_height="4dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="visible" />
                            <TextView
                                android:id="@+id/widget_fare_bar_1_level_1"
                                android:layout_width="12dp"
                                android:layout_height="8dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/widget_fare_bar_1_level_2"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/widget_fare_bar_1_level_3"
                                android:layout_width="12dp"
                                android:layout_height="16dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                            <TextView
                                android:id="@+id/widget_fare_bar_1_level_4"
                                android:layout_width="12dp"
                                android:layout_height="20dp"
                                android:layout_gravity="bottom|center_horizontal"
                                android:background="@drawable/widget_bar_track"
                                android:text=""
                                android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/widget_fare_bar_1_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Student"
                        android:textColor="#5A6B52"
                        android:textSize="9sp"
                        android:fontFamily="@font/baloo_2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open EstudyanteGO to load fares."
            android:textColor="#21301A"
            android:textSize="14sp"
            android:textStyle="bold" 
            android:fontFamily="@font/baloo_2"/>

        <TextView
            android:id="@+id/widget_empty_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fares load from the Fares tab when the app opens."
            android:textColor="#5A6B52"
            android:textSize="12sp" 
            android:fontFamily="@font/baloo_2"/>
    </LinearLayout>
</LinearLayout>
