<?xml version="1.0" encoding="utf-8"?>
<!--
  Bible Verse widget — sample look (Steven, Nov 8).

  The photo is INSIDE the widget: the widget is a rounded-corner
  card (16dp) and the photo fills that card edge to edge as the
  widget's own background. The photo is NOT clipped to the
  rounded rect: clipToOutline + outlineProvider were REMOVED
  Nov 8 — the EMUI launcher on Steven's Huawei P30 Lite
  rejected those attributes and the whole widget failed to
  load ("An error occurred when loading widget"). The photo may
  render square-cornered on launchers that don't clip; the
  scrim is rounded, and the card still reads as a photo widget.
  Loading matters more than perfect rounded corners.
  There is NO floating dark panel in the center: the logo,
  verse, and green pill sit DIRECTLY on the photo, with only a
  subtle full-area scrim for readability.

  The background photo follows the CATHOLIC SEASON / feast
  (provider picks it from the date: fixed feasts, then
  Advent/Christmas/Lent windows, Ordinary Time has its own
  photo, and only a season with no photo yet — Easter, the
  Triduum — falls back to the verse's nature photo). The
  default src below is the sunset/cross scene, used for the
  empty state and until the first update.
  The photos are BINARY: they cannot be pushed via the GitHub
  App and are web-uploaded into res/drawable (like the fonts
  and launch_image). The build fails on a missing drawable
  until they are uploaded.

  The header uses the REAL EstudyanteGO logo — the E logo
  (@drawable/launch_image, already in the repo) — next to the
  "EstudyanteGO" wordmark. The graduation cap from the original
  sample is NOT used (Steven, Nov 8: "dapat real logo natin").

  The verse is SANS-SERIF white, centered, in curly quotes, as
  in the sample (the sample's verse has no serifs). It is
  CENTERED in the card — horizontally AND vertically (Steven,
  Nov 8: "Center yung verse"; v4 sample approved Nov 8): the
  verse TextView fills the space between the header and the
  pill with gravity center, and the content padding is
  asymmetric (top 16dp, bottom 8dp) so the header/pill chrome
  balances and the verse's center sits on the card's center.
  The old footer ("EstudyanteGO · Bible Verse") is gone: the
  sample has none, and the logo is the branding.

  Light and night are intentionally IDENTICAL: the photo is
  the same in both themes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bible_widget_card_background">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bible_widget_card_background"
        android:src="@drawable/verse_bg_sunset_cross"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <View
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bible_widget_text_scrim" />

    <!-- Content padding is ASYMMETRIC on purpose (top 16dp,
         bottom 8dp). The header (28dp logo) is shorter than the
         footer (divider + 10dp gap + pill), so equal padding would
         leave the verse ~6dp above the card's true center; the
         8dp bottom padding balances the chrome and puts the
         verse's center on the card's center (Steven, Nov 8:
         "Center yung verse"). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/launch_image"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Estudyante"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowRadius="3"
                android:shadowDy="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GO"
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowRadius="3"
                android:shadowDy="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_verse"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:shadowColor="#CC000000"
            android:shadowRadius="5"
            android:shadowDy="1"
            android:maxLines="4"
            android:ellipsize="end" />

        <!-- Short divider, centered under the verse and just
             wider than the pill, as in the v4 sample (~40% of the
             card width at the usual 4-cell size) — NOT full-width. -->
        <View
            android:id="@+id/widget_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="80dp"
            android:layout_marginEnd="80dp"
            android:background="#40FFFFFF" />

        <TextView
            android:id="@+id/widget_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bible_widget_ref_pill"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
